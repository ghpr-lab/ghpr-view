# Copy to .env and fill in. .env is git-ignored.

# Target repo to analyze (does NOT need to be this repo).
TARGET_REPO=owner/repo
PR_NUMBER=123
RUN_ID=1234567890

# Fine-grained PAT with "Copilot Requests" permission on TARGET_REPO.
# https://github.com/settings/personal-access-tokens/new
COPILOT_PAT=

# Optional — defaults shown.
# GITHUB_TOKEN falls back to `gh auth token`; whichever token you use must have
# actions:read on TARGET_REPO (and checks:write if you set DRY_RUN=false).
# GITHUB_TOKEN=
# HEAD_SHA=              # auto-resolved from PR.head.sha if unset
# DRY_RUN=true           # "false" to actually write Check Run
# WRITE_PR_COMMENT=false # "true" also posts/updates a PR comment (needs issues+pulls write)
# JOB_IDS=               # comma-separated failed job ids; empty = all
# TRIGGER=local
# SCHEMA_VERSION=2
# CORRELATION_ID=
# REQUEST_ID=
# WORK_DIR=              # default: <action_dir>/.local-run
